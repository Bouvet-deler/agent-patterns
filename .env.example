# These map directly onto Spring AI properties. Use the SPRING_AI_* names so a
# globally-exported SPRING_AI_AZURE_OPENAI_API_KEY from another project can't
# shadow these (env vars outrank application.properties in Spring Boot).
SPRING_AI_AZURE_OPENAI_API_KEY=
SPRING_AI_AZURE_OPENAI_ENDPOINT=https://<you-azure-openai-resource>.openai.azure.com/
SPRING_AI_AZURE_OPENAI_CHAT_OPTIONS_DEPLOYMENT_NAME=gpt-4.1
